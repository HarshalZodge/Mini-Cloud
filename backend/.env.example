# MiniCloud Environment Configuration Template
# Copy this to .env and adjust variables as required

# App
FLASK_SECRET_KEY=change-this-to-a-secure-random-key-in-production
JWT_SECRET_KEY=change-this-jwt-secret-key-in-production
JWT_ACCESS_TOKEN_MINUTES=60
APP_HOST=0.0.0.0
APP_PORT=5000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_PATH=./minicloud.db
LOG_LEVEL=INFO

# Storage: 'hdfs' for real Hadoop cluster, 'mock' for local dev without Hadoop
STORAGE_BACKEND=mock
HDFS_NAMENODE_HOST=127.0.0.1
HDFS_WEBHDFS_PORT=9870
HDFS_BASE_PATH=/minicloud
HDFS_USER=hadoop
HDFS_REPLICATION_FACTOR=1
HDFS_DEFAULT_BLOCK_SIZE=134217728
HDFS_REQUEST_TIMEOUT_SECONDS=30
MOCK_STORAGE_DIR=./mock_storage

# Limits
MAX_UPLOAD_SIZE_MB=100
USER_STORAGE_QUOTA_MB=1024
BLOCKED_EXTENSIONS=.exe,.bat,.cmd,.sh,.js,.msi
